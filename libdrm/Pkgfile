# Description: Userspace interface to kernel DRM services
# URL: https://dri.freedesktop.org/
# Maintainer: CRUX Xorg Team, xorg-ports at crux dot nu
# Arch Maintainer: CRUX-ARM System Team, devel at crux-arm dot nu
# Depends on: libpthread-stubs xorg-libpciaccess
# Optional: python3-docutils

name=libdrm
version=2.4.130
release=1
source=(https://dri.freedesktop.org/libdrm/libdrm-$version.tar.xz)

build() {
    prt-get isinst python3-docutils && PKGMK_LIBDRM+=' -D man-pages=enabled' || PKGMK_LIBDRM+=' -D man-pages=disabled'

    meson setup build $name-$version $PKGMK_LIBDRM \
        --prefix=/usr \
        --buildtype=plain \
        --wrap-mode nodownload \
        -D b_lto=true \
        -D b_pie=true \
        -D vmwgfx=enabled \
        -D omap=enabled \
        -D exynos=enabled \
        -D tegra=enabled \
        -D man-pages=disabled \
        -D valgrind=disabled \
        -D cairo-tests=disabled

    meson compile -C build -j ${JOBS:-1}
    DESTDIR=$PKG meson install -C build
}
